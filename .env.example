APP_ENV=development
DEBUG=true
# Required to access stateful API and WebSocket endpoints. Keep this secret.
API_ACCESS_TOKEN=
DATABASE_URL=sqlite:///./codenex.db
CORS_ORIGINS=http://localhost:5173
WORKSPACE_ROOT=./workspaces
SANDBOX_IMAGE=codenex-sandbox:latest
SANDBOX_TIMEOUT=60
MAX_AGENT_RETRIES=3
NEBIUS_API_KEY=
# Official Nebius Token Factory OpenAI-compatible API base URL.
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEMOTRON_MODEL=
